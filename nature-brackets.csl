<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       class="in-text"
       version="1.0"
       demote-non-dropping-particle="sort-only"
       default-locale="en-GB">

  <info>
    <title>Nature (brackets, full authors, year)</title>
    <id>http://www.zotero.org/styles/nature-brackets-full-authors-year</id>
    <link href="http://www.zotero.org/styles/nature-brackets" rel="self"/>
    <category citation-format="numeric"/>
    <category field="science"/>
    <updated>2025-12-17T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/"/>
  </info>

  <!-- ===== TITLE ===== -->
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report song" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <!-- ===== AUTHORS (FULL NAMES, NO ET AL) ===== -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            initialize-with=""
            delimiter=", "
            delimiter-precedes-last="always"/>
    </names>
  </macro>

  <!-- ===== JOURNAL TITLE ===== -->
  <macro name="container-title">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <!-- ===== VOLUME ===== -->
  <macro name="volume">
    <text variable="volume" font-weight="bold"/>
  </macro>

  <!-- ===== DOI (FULL LINK) ===== -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>

  <!-- ===== IN-TEXT CITATION [1, 2] ===== -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- ===== BIBLIOGRAPHY (ET AL DISABLED) ===== -->
  <bibliography et-al-min="999"
                et-al-use-first="999"
                second-field-align="flush"
                entry-spacing="0"
                line-spacing="2">

    <layout suffix=".">
      <text variable="citation-number" suffix="."/>
      <group delimiter=" ">

        <!-- Authors -->
        <text macro="author"/>

        <!-- Year -->
        <date variable="issued">
          <date-part name="year" prefix=" (" suffix=")."/>
        </date>

        <!-- Title -->
        <text macro="title" suffix="."/>

        <!-- Journal -->
        <text macro="container-title"/>

        <!-- Volume -->
        <text macro="volume" prefix=" "/>

        <!-- Pages (optional) -->
        <text variable="page" prefix=", "/>

        <!-- DOI -->
        <text macro="access"/>

      </group>
    </layout>
  </bibliography>

</style>
